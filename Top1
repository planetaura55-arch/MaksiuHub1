
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Run = game:GetService("RunService")
local me = Players.LocalPlayer
local camera = workspace.CurrentCamera

local gui = Instance.new("ScreenGui")
gui.Name = "MAKSIU HUB"
gui.ResetOnSpawn = false
gui.Parent = me:WaitForChild("PlayerGui")

local function make(parent, class, size, pos, text)
 local o = Instance.new(class)
 o.Size = size
 o.Position = pos
 o.BackgroundColor3 = Color3.new(0,0,0)
 o.Text = text or ""
 o.TextColor3 = Color3.new(1,1,1)
 o.Font = Enum.Font.GothamBold
 o.TextSize = 14
 o.Parent = parent
 local c = Instance.new("UICorner",o)
 c.CornerRadius = UDim.new(0,14)
 return o
end

-- LOGIN
local login = make(gui,"Frame",UDim2.fromScale(.7,.38),UDim2.fromScale(.15,.31))
local title = make(login,"TextLabel",UDim2.fromScale(.9,.25),UDim2.fromScale(.05,.05),"MAKSIU HUB")
