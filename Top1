local function hub()
 login:Destroy()

 local frame = make(gui,"Frame",UDim2.fromScale(.75,.85),UDim2.fromScale(.125,.075))
 local head = make(frame,"TextLabel",UDim2.fromScale(.55,.09),UDim2.fromScale(.02,.01),"MAKSIU HUB")
 head.BackgroundTransparency = 1

 local close = make(frame,"TextButton",UDim2.fromScale(.12,.08),UDim2.fromScale(.85,.01),"X")
 local mini = make(frame,"TextButton",UDim2.fromScale(.12,.08),UDim2.fromScale(.71,.01),"—")

 local visual = make(frame,"TextButton",UDim2.fromScale(.4,.1),UDim2.fromScale(.03,.13),"VISUAL")
 local aim = make(frame,"TextButton",UDim2.fromScale(.4,.1),UDim2.fromScale(.53,.13),"AIMBOT")

 local panel = make(frame,"Frame",UDim2.fromScale(.94,.68),UDim2.fromScale(.03,.27))
 local esp = make(panel,"TextButton",UDim2.fromScale(.9,.13),UDim2.fromScale(.05,.05),"ESP: OFF")
 local aimb = make(panel,"TextButton",UDim2.fromScale(.9,.13),UDim2.fromScale(.05,.05),"AIMBOT: OFF")
 aimb.Visible = false

 local fovBtn = make(panel,"TextButton",UDim2.fromScale(.9,.13),UDim2.fromScale(.05,.23),"FOV: 120")
 fovBtn.Visible = false

 local smoothBtn = make(panel,"TextButton",UDim2.fromScale(.9,.13),UDim2.fromScale(.05,.41),"SMOOTH: 0.15")
 smoothBtn.Visible = false

 local espOn = false
 local aimOn = false
 local fov = 120
 local smooth = .15

 local function updateESP(p)
  if p == me or not p.Character then return end
  local char = p.Character
  local old = char:FindFirstChild("MaksESP")

  if espOn and not old then
   local h = Instance.new("Highlight")
   h.Name = "MaksESP"
   h.FillColor = Color3.new(1,0,0)
   h.OutlineColor = Color3.new(1,0,0)
   h.FillTransparency = .3
   h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
   h.Parent = char
  elseif not espOn and old then
   old:Destroy()
  end
 end

 local function toggleESP()
  espOn = not espOn
  esp.Text = "ESP: "..(espOn and "ON" or "OFF")
  for _,p in ipairs(Players:GetPlayers()) do updateESP(p) end
 end

 esp.MouseButton1Click:Connect(toggleESP)

 visual.MouseButton1Click:Connect(function()
  esp.Visible = true
  aimb.Visible = false
  fovBtn.Visible = false
  smoothBtn.Visible = false
 end)

 aim.MouseButton1Click:Connect(function()
  esp.Visible = false
  aimb.Visible = true
  fovBtn.Visible = true
  smoothBtn.Visible = true
 end)

 aimb.MouseButton1Click:Connect(function()
  aimOn = not aimOn
  aimb.Text = "AIMBOT: "..(aimOn and "ON" or "OFF")
 end)

 fovBtn.MouseButton1Click:Connect(function()
  fov = fov + 20
  if fov > 240 then fov = 60 end
  fovBtn.Text = "FOV: "..fov
 end)

 smoothBtn.MouseButton1Click:Connect(function()
  smooth = smooth + .05
  if smooth > .5 then smooth = .05 end
  smoothBtn.Text = "SMOOTH: "..smooth
 end)

 Players.PlayerAdded:Connect(function(p)
  p.CharacterAdded:Connect(function()
   task.wait(1)
   updateESP(p)
  end)
 end)

 for _,p in ipairs(Players:GetPlayers()) do
  if p ~= me then
   p.CharacterAdded:Connect(function()
    task.wait(1)
    updateESP(p)
   end)
  end
 end

 -- FOV CIRCLE
 local circle = Instance.new("Frame")
 circle.Name = "FOV"
 circle.AnchorPoint = Vector2.new(.5,.5)
 circle.Position = UDim2.fromScale(.5,.5)
 circle.Size = UDim2.fromOffset(fov*2,fov*2)
 circle.BackgroundTransparency = 1
 circle.Visible = false
 circle.Parent = gui

 local corner = Instance.new("UICorner",circle)
 corner.CornerRadius = UDim.new(1,0)
 local stroke = Instance.new("UIStroke",circle)
 stroke.Color = Color3.new(1,0,0)
 stroke.Thickness = 2

 -- AIM ASSIST: własna gra
 Run.RenderStepped:Connect(function()
  circle.Visible = aimOn
  circle.Size = UDim2.fromOffset(fov*2,fov*2)

  if not aimOn then return end

  local target, distance
  distance = fov

  for _,p in ipairs(Players:GetPlayers()) do
   if p ~= me and p.Character then
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    local part = p.Character:FindFirstChild("Head")

    if hum and hum.Health > 0 and part then
     local pos, visible = camera:WorldToViewportPoint(part.Position)
     local center = camera.ViewportSize/2
     local d = (Vector2.new(pos.X,pos.Y)-center).Magnitude

     if visible and d < distance then
      distance = d
      target = part
     end
    end
   end
  end

  if target then
   local goal = CFrame.lookAt(camera.CFrame.Position,target.Position)
   camera.CFrame = camera.CFrame:Lerp(goal,smooth)
  end
 end)

