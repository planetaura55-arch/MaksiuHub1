local function check()
 if logged then return end
 if pass.Text == "Maks" then
  logged = true
  hub()
 else
  pass.Text = ""
  pass.PlaceholderText = "BŁĘDNE HASŁO!"
 end
end

enter.MouseButton1Click:Connect(check)
pass.FocusLost:Connect(function(pressed)
 if pressed then check() end
end)
